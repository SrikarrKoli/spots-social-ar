# SQLite file. Relative paths are resolved from the repository root.
APP_DATABASE_PATH=./data/locus.db

# camera | fixture | disabled
APP_CAMERA_SOURCE=camera
APP_CAMERA_INDEX=0
APP_CAMERA_FIXTURE=./markers/markerless-fixture.png
APP_CAMERA_WIDTH=1280
APP_CAMERA_HEIGHT=720
APP_DETECTION_TTL_MS=2000

# Markerless instance recognition is the demo default.
# instance | aruco (aruco is a legacy dev/test fixture only)
APP_RECOGNIZER=instance
APP_ENROLLED_DIR=./data/enrolled
APP_MARKER_DICTIONARY=DICT_4X4_50

# Sustained-performance limits. Historical views remain stored, but only the
# bounded active set participates in recognition.
APP_MAX_REFERENCE_FILES_PER_IDENTITY=4
APP_MAX_AUTO_BANKED_FILES_PER_IDENTITY=2
APP_RECOGNITION_MAX_WIDTH=960
APP_RECOGNITION_FPS=8
APP_STREAM_FPS=15
APP_STREAM_JPEG_QUALITY=75
APP_OPENCV_THREADS=3

# disabled | openai | faster-whisper
APP_TRANSCRIPTION_PROVIDER=disabled

# Cloud transcription (only used when provider=openai)
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSCRIPTION_PROMPT=Names in this social app may include Vishal, Pravan, Theo, and Lina.

# Local transcription (only used when provider=faster-whisper)
APP_WHISPER_MODEL=medium
APP_WHISPER_DEVICE=cpu
APP_WHISPER_COMPUTE_TYPE=int8

# Local camera-aware conversation. Requires Ollama with this vision model installed.
APP_ASSISTANT_MODEL=qwen3.5:4b
APP_OLLAMA_URL=http://127.0.0.1:11434
# For quicker English speech turns on a MacBook, APP_WHISPER_MODEL=small.en.

# Structured local LLM parsing for spoken actions and comment content.
APP_LLM_PARSER_ENABLED=true

# Isolated sample menu objects for the Instagram presentation.
APP_RESTAURANT_DEMO=true

# On macOS select the camera by name; the built-in camera is never used as a fallback.
APP_CAMERA_NAME=Brio 100

# Assistant voice. kokoro renders speech locally with the Heart voice (needs
# `brew install espeak-ng` and `uv sync --extra voice`); browser uses the system voice.
APP_SPEECH_PROVIDER=kokoro
APP_SPEECH_VOICE=af_heart
# Only needed when eSpeak NG is not under /opt/homebrew or /usr/local.
# APP_ESPEAK_LIBRARY=/opt/homebrew/opt/espeak-ng/lib/libespeak-ng.dylib
# APP_ESPEAK_DATA=/opt/homebrew/opt/espeak-ng/share/espeak-ng-data
