# SQLite file. Relative paths are resolved from the repository root.
APP_DATABASE_PATH=./data/locus.db

# camera | fixture | disabled
APP_CAMERA_SOURCE=camera
APP_CAMERA_INDEX=0
# Optional, macOS: pick the camera by name (e.g. Brio 100) instead of index.
# Falls back to APP_CAMERA_INDEX when no device name matches.
APP_CAMERA_NAME=
APP_CAMERA_FIXTURE=./markers/demo-fixture.png
APP_CAMERA_WIDTH=1280
APP_CAMERA_HEIGHT=720
APP_DETECTION_TTL_MS=750
APP_MARKER_DICTIONARY=DICT_4X4_50

# General object detection (80 COCO classes: person, cup, book, laptop, ...).
# yolo | disabled. The model file is downloaded on first start if missing.
APP_OBJECT_DETECTION=yolo
APP_OBJECT_MODEL=./models/yolo11n.pt
APP_OBJECT_CONFIDENCE=0.45
APP_OBJECT_INTERVAL_MS=150

# disabled | openai
APP_TRANSCRIPTION_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSCRIPTION_PROMPT=Names in this social app may include Maya, Theo, and Lina.
