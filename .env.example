# SQLite file. Relative paths are resolved from the repository root.
APP_DATABASE_PATH=./data/locus.db

# camera | fixture | disabled
APP_CAMERA_SOURCE=camera
APP_CAMERA_INDEX=0
APP_CAMERA_FIXTURE=./markers/markerless-fixture.png
APP_CAMERA_WIDTH=1280
APP_CAMERA_HEIGHT=720
APP_DETECTION_TTL_MS=750

# Markerless instance recognition is the demo default.
# instance | aruco (aruco is a legacy dev/test fixture only)
APP_RECOGNIZER=instance
APP_ENROLLED_DIR=./data/enrolled
APP_MARKER_DICTIONARY=DICT_4X4_50

# disabled | openai
APP_TRANSCRIPTION_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSCRIPTION_PROMPT=Names in this social app may include Maya, Theo, and Lina.
